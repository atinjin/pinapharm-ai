# LLM 경로: openrouter(기본, Anthropic 호환 입력) | anthropic(비상용 직접 호출)
LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY="sk-or-..."
# LLM_PROVIDER=anthropic일 때만 필요
# ANTHROPIC_API_KEY="sk-ant-..."
# 모델은 Anthropic 네이티브 ID 그대로 둬도 된다(openrouter 경로에서 anthropic/… 슬러그로 자동 변환)
ANTHROPIC_MODEL="claude-opus-4-8"
WEB_INTERNAL_URL="http://localhost:3000"
