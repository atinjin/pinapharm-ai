DATABASE_URL="file:./dev.db"

# 결제 — 토스페이먼츠 (테스트 키)
TOSS_SECRET_KEY="test_sk_..."
TOSS_WEBHOOK_SECRET=""
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_..."
AGENT_URL="http://localhost:8000"
# 식품안전나라 건강기능식품(C003) OpenAPI 키 (실제 제품 import 시 필요)
# 발급: https://www.foodsafetykorea.go.kr/api/openApiInfo.do?svc_no=C003
MFDS_API_KEY=""

# 임베딩(RAG) — Voyage
VOYAGE_API_KEY=""
EMBEDDING_PROVIDER="voyage"
# 모델을 바꾸면 재색인 필요: npm run index:products && npm run index:knowledge -- --reembed
EMBEDDING_MODEL="voyage-4-lite"
# 참고값(코드는 읽지 않음). voyage-4-lite 기본 출력 차원 1024
EMBEDDING_DIM="1024"
